          "command": "/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport hashlib\nimport re\nfrom urllib.parse import unquote, urlsplit\n\nroot = Path.cwd()\ninstallation = root / 'docs/okms'\nsource = Path('/home/beebiz/workspace/okms/templates/plan-first/docs')\noriginal_hashes = {\n    '.gitignore': '862263fa1f46c20f0d1e4dac5ffcc75abd55c08211b2c3864c5f8764b9d87793',\n    'api.py': '2bbb9199b83be2a332940558cec80a79e45c26d0a7a5142526b6e3441d33bdfc',\n    'docs/README.md': 'ecae367341d4f1e7b9310fbddefb9ec96878cde5e3da5d44d39795b32f42b949',\n    'pagination.py': 'b734c4c00853a1669e7ac6136ab3d8fb07effae7fdd7ad4cda71f3d56e244fdb',\n    'tests/test_existing.py': '5ef975593f1dcebf87ee7eae5a8230b03529a656cec638ffd5639de574d20655',\n}\nfor relative, expected in original_hashes.items():\n    assert hashlib.sha256((root / relative).read_bytes()).hexdigest() == expected, relative\n\nagents = (root / 'AGENTS.md').read_bytes()\npointer = b'For implementation tasks, read and follow [the workflow](docs/okms/workflow.md), starting with [the docs index](docs/okms/index.md).\\\\n'\nassert agents.count(pointer) == 1, 'Workflow pointer must occur exactly once.'\nassert agents.endswith(b'\\\\n' + pointer)\noriginal_agents = agents[:-(len(pointer) + 1)]\nassert hashlib.sha256(original_agents).hexdigest() == '0614958819ec9fa64caabd1c4b285e8dee66b7020e1e912d41fb3185e7c3f1e3', 'Original agent instructions changed.'\n\npayload_files = sorted(source.rglob('*.md'))\nassert len(list(installation.rglob('*.md'))) == len(payload_files) == 7\nfor path in payload_files:\n    relative = path.relative_to(source)\n    if relative \"'!= Path('\"'context.md'):\n        assert (installation / relative).read_bytes() == path.read_bytes(), relative\n\nworkflow = (installation / 'workflow.md').read_text()\nfrontmatter = workflow.split('---', 2)[1]\nassert re.search(r'\"'^template: plan-first$'\"', frontmatter, re.M)\nassert re.search(r'\"'^template_version: \"0'\"\\\\.1\\\\.0\\\"\"'$'\"', frontmatter, re.M)\ncontext = (installation / 'context.md').read_text()\nassert '{{' not in context, 'Unresolved context placeholder.'\nassert 'python3 -m unittest discover -s tests -v' in context\nassert 'unknown' in context\n\nlinks = 0\nfor path in [root / 'AGENTS.md', *sorted(installation.rglob('*.md'))]:\n    for target in re.findall(r'\\\\[[\"'^'\"\\\\]]*\\\\]\\\\(([\"'^)]+)'\"\\\\)', path.read_text()):\n        parsed = urlsplit(target)\n        if parsed.scheme or parsed.netloc or not parsed.path:\n            continue\n        resolved = (path.parent / unquote(parsed.path)).resolve()\n        assert resolved.exists(), f'Broken link in {path.relative_to(root)}: {target}'\n        links += 1\nprint(f'Validated {links} local links and plan-first 0.1.0 metadata.')\nprint('Verified seven-file payload; six uncustomized template files match the source.')\nprint('Verified existing documentation, code, tests, and agent instructions were preserved; workflow pointer occurs once.')\nprint('Project context uses actual project files and the documented required check, with no unresolved placeholders.')\nPY\"",
